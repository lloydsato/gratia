---
import '@fontsource-variable/archivo';
// Static (non-variable) files for anything drawn as an outline: variable fonts carry overlapping
// contours that show up as stray lines under -webkit-text-stroke.
import '@fontsource/archivo/900.css';
import '@fontsource/bodoni-moda/400-italic.css';
import '@fontsource-variable/hanken-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../../styles/motion.css';

import Base from '../../layouts/Base.astro';
import BeanField from '../../components/BeanField.astro';
import Burst from '../../components/Burst.astro';
import Arrow from '../../components/Arrow.astro';
import { brand, nav, hero, thanks, statement, stats, coffees, process, cafes, order, wholesale } from '../../content/gratia';

// Duotone plates: black / bone / one orange bean on the house blend. Two-tone system, one loud accent.
const BONE = '#dbdcca';
const plates: Record<string, { bg: string; palette: string[]; groove: string }> = {
  huila: { bg: '#161616', palette: [BONE, '#bdbeab'], groove: '#161616' },
  guji: { bg: BONE, palette: ['#161616', '#262626'], groove: BONE },
  cerrado: { bg: '#161616', palette: ['#3b3b3b', '#4a4a4a', '#303030'], groove: '#161616' },
  gracias: { bg: '#c9cab8', palette: ['#161616', '#161616', '#161616', '#ff6b2c'], groove: '#c9cab8' },
};
---

<Base title={`${brand.full} · Motion`} themeColor="#000000" bodyClass="mo" sample={2}>
  <script is:inline slot="head">
    (function () {
      try {
        var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        var seen = sessionStorage.getItem('gratia-pl-motion');
        if (!reduced && (!seen || /[?&]intro/.test(location.search))) document.documentElement.classList.add('pl-on');
      } catch (e) {
        document.documentElement.classList.add('pl-on');
      }
    })();
  </script>

  <a class="skip-link" href="#main">Skip to content</a>
  <div class="grain" aria-hidden="true"></div>

  <!-- Custom cursor: only activated by JS on fine pointers -->
  <div class="cursor-dot" aria-hidden="true"></div>
  <div class="cursor-ring" aria-hidden="true"><span class="cursor-label"></span></div>

  <!-- Preloader: cycling thank-yous + counter, then the curtain parts -->
  <div class="preloader" role="status" aria-label="Loading">
    <div class="preloader__panel preloader__panel--top"></div>
    <div class="preloader__panel preloader__panel--bottom"></div>
    <p class="preloader__word" aria-hidden="true">{thanks[0]}</p>
    <span class="preloader__count" aria-hidden="true">0</span>
  </div>

  <header class="site-header">
    <a class="site-header__brand" href="#top" data-cursor-hover aria-label={`${brand.name}, back to top`}>
      <Burst class="site-header__mark" spokes={12} inner={9} outer={46} stroke={5} />
      <span class="site-header__word">{brand.name}</span>
    </a>
    <nav class="site-header__nav" aria-label="Primary">
      {nav.map((n) => <a href={n.href} data-cursor-hover>{n.label}</a>)}
    </nav>
    <a class="site-header__cta" href="#order" data-magnetic data-cursor-hover>Subscribe</a>
  </header>

  <main id="main">
    <!-- 1. HERO -->
    <section class="hero" id="top">
      <Burst class="hero__burst" spokes={28} inner={9} outer={48} stroke={0.7} />
      <h1 class="hero__title">
        <span class="hero__line" data-split>Coffee, with</span>
        <span class="hero__line hero__line--cursive" data-split>thanks.</span>
      </h1>
      <div class="hero__aside">
        <p class="hero__sub">{hero.lede}</p>
        <div class="hero__ctas">
          <a class="pill pill--solid" href="#order" data-magnetic data-cursor-hover>{hero.primaryCta}</a>
          <a class="arrow-link" href="#coffee" data-cursor-hover>{hero.secondaryCta}<Arrow /></a>
        </div>
      </div>
      <ul class="hero__meta mono">
        <li>— Roasted this week</li>
        <li>— Ships in 48 h</li>
        <li>— Three cafés</li>
      </ul>
    </section>

    <!-- 2. MARQUEE: the brand's thank-you device -->
    <div class="marquee" aria-label="Thank you, in many languages" role="img">
      <div class="marquee__track" aria-hidden="true">
        {[0, 1].map(() => (
          <span>
            {thanks.map((t) => (<><span class="marquee__w">{t}</span><Burst class="marquee__burst" spokes={12} inner={10} outer={46} stroke={6} /></>))}
          </span>
        ))}
      </div>
    </div>

    <!-- 3. STATEMENT (words brighten as you scroll) -->
    <section class="statement-section" id="studio">
      <h2 class="sr-only">What we believe</h2>
      <p class="statement" data-scrub-text>{statement.text}</p>
    </section>

    <!-- 4. NUMBERS -->
    <section class="numbers" aria-label="Gratia in numbers">
      <ul class="numbers__list">
        {stats.map((s, i) => (
          <li class={`numbers__item ${i % 2 ? 'is-outline' : ''}`}>
            <span class="numbers__num"><span data-count={s.value}>{s.value}</span><span class="numbers__suffix">{s.suffix}</span></span>
            <span class="numbers__label mono">{s.label}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- 5. COFFEES: draggable momentum filmstrip -->
    <section class="work" id="coffee" aria-labelledby="coffee-h">
      <div class="work__header">
        <h2 class="section-title" id="coffee-h">Four coffees,<br /><em>roasted this week</em></h2>
        <p class="work__hint mono">Drag to explore<Arrow /></p>
      </div>
      <div class="work__viewport" data-cursor-label="Drag">
        <ul class="work__track">
          {coffees.map((c) => {
            const p = plates[c.id];
            return (
              <li class="work__card">
                <div class="work__media">
                  <BeanField id={`mo-${c.id}`} seed={c.name.length * 7} palette={p.palette} groove={p.groove} bg={p.bg} cols={5} rows={6} w={400} h={500} scale={[0.85, 1.1]} jitter={0.28} />
                  <span class="work__tag mono">{c.roastLabel} roast</span>
                </div>
                <div class="work__meta">
                  <h3>{c.name}</h3>
                  <p class="mono work__origin">{c.origin} · {c.process} · {c.altitude}</p>
                  <p class="work__notes">{c.notes.join(' / ')}</p>
                  <div class="work__buy">
                    <span class="work__price">{c.price} <span class="mono">/ {c.size}</span></span>
                    <a class="pill pill--line" href="#order" data-cursor-hover aria-label={`Subscribe to ${c.name}`}>Subscribe</a>
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <!-- 6. ROASTERY -->
    <section class="roastery" id="roastery" aria-labelledby="roast-h">
      <div class="roastery__copy">
        <h2 class="section-title" id="roast-h">Slow on purpose,<br /><em>fast to your door</em></h2>
        <ol class="steps">
          {process.map((p, i) => (
            <li class="steps__item" data-cursor-hover>
              <span class="steps__index mono">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="steps__title">{p.title}</h3>
              <p class="steps__desc">{p.text}</p>
            </li>
          ))}
        </ol>
      </div>
      <div class="roastery__plate" aria-hidden="true">
        <BeanField id="mo-roast" seed={42} palette={[BONE, '#9a9b8a', '#ffffff']} groove="#000000" bg="#000000" cols={6} rows={9} w={600} h={800} scale={[0.9, 1.2]} jitter={0.3} gaps={0.08} />
      </div>
    </section>

    <!-- 7. CAFÉS -->
    <section class="cafes" id="cafes" aria-labelledby="cafes-h">
      <h2 class="section-title" id="cafes-h">Come and<br /><em>say hello</em></h2>
      <ul class="cafes__list">
        {cafes.map((c) => (
          <li class="cafes__item" data-cursor-hover>
            <h3 class="cafes__name">{c.name}</h3>
            <p class="cafes__where">{c.address}<span>{c.note}</span></p>
            <p class="cafes__hours mono">{c.hours}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- 8. ORDER -->
    <section class="cta" id="order" aria-labelledby="order-h">
      <h2 class="cta__title" id="order-h">
        <span class="cta__line">Beans at your door</span>
        <span class="cta__line cta__line--outline">in 48 hours.</span>
      </h2>
      <p class="cta__text">{order.text}</p>

      <form class="cta__form" data-mock-form>
        <label class="field">
          <span class="field__label mono">{order.emailLabel}</span>
          <input type="email" name="email" required autocomplete="email" placeholder={order.emailPlaceholder} />
        </label>
        <label class="field">
          <span class="field__label mono">{order.brewLabel}</span>
          <select name="brew">{order.brewOptions.map((o) => <option>{o}</option>)}</select>
        </label>
        <button class="pill pill--solid pill--lg" type="submit" data-magnetic data-cursor-hover>{order.submit}</button>
        <p class="cta__status mono" data-form-status role="status" aria-live="polite"></p>
      </form>

      <p class="cta__wholesale">{wholesale.text}
        <a class="cta__email" href={`mailto:${brand.email}`} data-cursor-hover><span>{brand.email}</span></a>
      </p>
    </section>
  </main>

  <footer class="site-footer">
    <div class="site-footer__top">
      <p class="site-footer__blurb">{brand.name}: {brand.meaning.toLowerCase()}. {brand.tagline}</p>
      <nav class="site-footer__nav" aria-label="Footer">
        {nav.map((n) => <a href={n.href} data-cursor-hover>{n.label}</a>)}
      </nav>
      <ul class="site-footer__social">
        <li><a href="#top" data-cursor-hover>Instagram</a></li>
        <li><a href="#top" data-cursor-hover>Journal</a></li>
        <li><a href="#top" data-cursor-hover>Wholesale</a></li>
      </ul>
    </div>
    <div class="site-footer__bottom">
      <p class="site-footer__copy">© {brand.year} {brand.name} · {brand.placeholderNote}</p>
      <a class="back-to-top" href="#top" data-magnetic data-cursor-hover aria-label="Back to top"><Arrow dir="up" /></a>
    </div>
  </footer>

  <script>
    import '../../scripts/motion';
  </script>
</Base>

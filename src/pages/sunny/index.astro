---
import '@fontsource-variable/archivo';
import '@fontsource/young-serif';
import '../../styles/sunny.css';

import Base from '../../layouts/Base.astro';
import BeanField from '../../components/BeanField.astro';
import Sticker from '../../components/Sticker.astro';
import Arrow from '../../components/Arrow.astro';
import { brand, nav, hero, thanks, statement, stats, coffees, process, cafes, order, wholesale } from '../../content/gratia';

const COBALT = '#1d2f8a', SUN = '#ffc62d', TOMATO = '#c9301a', CREAM = '#f7f0e1';
// One bag colourway per coffee. Flat fields only.
const bags: Record<string, { body: string; ink: string; name: string }> = {
  huila: { body: SUN, ink: COBALT, name: 'Huila' },
  guji: { body: TOMATO, ink: COBALT, name: 'Guji' },
  cerrado: { body: COBALT, ink: COBALT, name: 'Cerrado' },
  gracias: { body: CREAM, ink: COBALT, name: 'Gracias' },
};
---

<Base title={`${brand.full} · Sunny`} themeColor="#f7f0e1" bodyClass="su" sample={4}>
  <a class="skip-link" href="#main">Skip to content</a>

  <!-- 1. NAVBAR + FULL-SCREEN MENU -->
  <header class="navbar">
    <a class="wordmark" href="#top" aria-label={`${brand.name}, back to top`}>{brand.name}</a>
    <div class="navbar__right">
      <a class="btn" href="#order">Subscribe</a>
      <button class="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <nav class="menu" id="menu" aria-label="Main menu" hidden>
    <button class="btn btn--small menu__close" type="button">Close</button>
    <a href="#order">Subscribe</a>
    {nav.slice(0, 3).map((n) => <a href={n.href}>{n.label}</a>)}
  </nav>

  <main id="main">
    <!-- 2. HERO: a flat field, tone-on-tone bean pattern, sticker illustrations -->
    <section class="hero on-dark" id="top">
      <BeanField class="hero__pattern" id="su-hero" seed={11} palette={['#2540a6', '#2a46b0']} groove="#1d2f8a" bg="#1d2f8a" cols={10} rows={6} w={1200} h={700} scale={[0.85, 1.1]} jitter={0.3} />
      <Sticker class="hero__bag" kind="bag" body={SUN} ink={COBALT} name="Gratia" />
      <Sticker class="hero__cup" kind="cup" body={TOMATO} ink={CREAM} />
      <div class="hero__body">
        <h1 class="t-hero">Coffee,<br />with thanks.</h1>
        <p class="t-lead">{hero.lede}</p>
        <p class="hero__cta">
          <a class="btn" href="#order">{hero.primaryCta}</a>
          <a class="btn btn--ghost" href="#coffee">{hero.secondaryCta}</a>
        </p>
      </div>
    </section>

    <!-- 3. STATEMENT -->
    <section class="section">
      <h2 class="sr-only">What we believe</h2>
      <p class="t-statement reveal">{statement.text}</p>
    </section>

    <!-- 4. NUMBERS (sun band) -->
    <section class="figures on-sun" aria-label="Gratia in numbers">
      <ul class="figures__list">
        {stats.map((s) => (
          <li class="figures__item reveal">
            <span class="t-figure">{s.value}<span class="t-figure__suffix">{s.suffix}</span></span>
            <span class="t-small">{s.label}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- 5. COFFEES: scroll-snap slider -->
    <section class="section" id="coffee" aria-labelledby="coffee-title">
      <h2 class="t-section center" id="coffee-title">Our coffees</h2>
      <div class="slider-wrap">
        <ul class="slider" id="slider" tabindex="0" aria-label="Coffees, scroll sideways">
          {coffees.map((c) => {
            const b = bags[c.id];
            return (
              <li class="card">
                <Sticker class="card__art" kind="bag" body={b.body} ink={b.ink} name={b.name} />
                <h3 class="t-name">{c.name}</h3>
                <p class="t-small card__origin">{c.origin} · {c.process} · {c.roastLabel} roast</p>
                <p class="t-body">{c.notes.join(', ')}.</p>
                <p class="card__buy">
                  <span class="t-price">{c.price} <span class="t-small">/ {c.size}</span></span>
                  <a class="btn btn--small btn--inverse" href="#order" aria-label={`Subscribe to ${c.name}`}>Subscribe</a>
                </p>
              </li>
            );
          })}
        </ul>
        <div class="slider-controls">
          <button class="btn btn--small" type="button" data-slide="-1" aria-label="Back to the previous coffee"><Arrow dir="left" />Back</button>
          <button class="btn btn--small btn--inverse" type="button" data-slide="1" aria-label="Next coffee">Next<Arrow dir="right" /></button>
        </div>
      </div>
    </section>

    <!-- 6. ROTATED MARQUEE -->
    <div class="marquee-wrap" aria-hidden="true">
      <div class="marquee">
        <div class="marquee__track">
          {[0, 1].map(() => thanks.map((t, i) => <span class={`marquee__item ${i % 2 ? 'marquee__item--outline' : ''}`}>{t}</span>))}
        </div>
      </div>
    </div>

    <!-- 7. ROASTERY -->
    <section class="section" id="roastery" aria-labelledby="roast-title">
      <h2 class="t-section center" id="roast-title">Slow roast,<br />fast shipping</h2>
      <ol class="steps">
        {process.map((p) => (
          <li class="step reveal">
            <h3 class="t-address">{p.title}</h3>
            <p class="t-body">{p.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- 8. CAFÉS: hours up front -->
    <section class="section section--tight" id="cafes" aria-labelledby="cafes-title">
      <h2 class="t-section center" id="cafes-title">Visit us</h2>
      <div class="locations">
        {cafes.map((c) => (
          <div class="location reveal">
            <svg class="location__glyph" viewBox="0 0 60 60" aria-hidden="true" focusable="false">
              <circle cx="30" cy="30" r="29" fill={SUN}></circle>
              <path d="M16 26h26v10c0 7-5 12-13 12s-13-5-13-12zM42 29h3c4 0 4 8 0 8h-3" fill="none" stroke={COBALT} stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M24 12c-2 3 2 4 0 8M31 10c-2 3 2 5 0 9" fill="none" stroke={COBALT} stroke-width="2.6" stroke-linecap="round"></path>
            </svg>
            <h3 class="t-address">{c.name}</h3>
            <p class="t-small">{c.address}</p>
            <p class="t-hours">{c.hours}</p>
            <p class="t-small location__note">{c.note}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 9. ORDER BAND (the single hot band) -->
    <section class="band on-tomato" id="order" aria-label="Order">
      <div class="band__scroll">
        <span class="t-band">{order.title}</span>
        <a class="btn" href="#subscribe">Start a subscription</a>
        <span class="t-band" aria-hidden="true">{order.title}</span>
      </div>
    </section>

    <!-- 10. SUBSCRIPTION FORM (pill fields) -->
    <section class="section" id="subscribe" aria-labelledby="sub-title">
      <h2 class="t-section center" id="sub-title">{hero.primaryCta}</h2>
      <p class="t-body center sub-text">{order.text}</p>
      <form class="form" data-mock-form>
        <div class="field">
          <label for="f-email">{order.emailLabel}</label>
          <input id="f-email" name="email" type="email" autocomplete="email" required placeholder={order.emailPlaceholder} />
        </div>
        <div class="field">
          <label for="f-brew">{order.brewLabel}</label>
          <select id="f-brew" name="brew">{order.brewOptions.map((o) => <option>{o}</option>)}</select>
        </div>
        <button class="btn btn--inverse btn--large" type="submit">{order.submit}</button>
        <p class="form__status" data-form-status role="status" aria-live="polite"></p>
      </form>
    </section>

    <!-- 11. WHOLESALE (sun band) -->
    <section class="team on-sun" aria-labelledby="team-title">
      <h2 class="t-section" id="team-title">{wholesale.title}</h2>
      <p class="t-body">{wholesale.text}</p>
      <a class="btn btn--inverse" href={`mailto:${brand.email}`}>{wholesale.cta}</a>
    </section>
  </main>

  <!-- 12. FOOTER -->
  <footer class="footer on-dark">
    <div class="footer__col">
      <a class="wordmark" href="#top" aria-label={`${brand.name}, back to top`}>{brand.name}</a>
      <p>{brand.name}: {brand.meaning.toLowerCase()}.</p>
    </div>
    <div class="footer__col">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </div>
    <div class="footer__col">
      <h4>The Roastery Bar</h4>
      <p>Unit 4, Mill Lane<br />Wed–Sun · 9:00–16:00</p>
      <h4>Contact</h4>
      <p>{brand.email}</p>
    </div>
    <div class="footer__col">
      <h4>Note</h4>
      <p>{brand.placeholderNote}</p>
      <p>© {brand.year} {brand.name}</p>
    </div>
  </footer>

  <script>
    import '../../scripts/sunny';
  </script>
</Base>

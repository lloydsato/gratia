---
import '@fontsource/bebas-neue';
import '@fontsource-variable/figtree';
import '../../styles/editorial.css';

import Base from '../../layouts/Base.astro';
import BeanField from '../../components/BeanField.astro';
import { brand, nav, hero, thanks, statement, stats, coffees, process, cafes, order, wholesale } from '../../content/gratia';

// Contact sheet of roast stages: the beans change colour as they roast. Muted so the cool room holds.
const stages = [
  { label: 'Green', note: 'Day 0', bg: '#1c2320', palette: ['#8c9a8a', '#7d8b7b', '#9aa898'], groove: '#1c2320' },
  { label: 'Yellowing', note: 'Minute 5', bg: '#26231a', palette: ['#c9b98a', '#b9a977', '#d3c595'], groove: '#26231a' },
  { label: 'First crack', note: 'Minute 11', bg: '#211a14', palette: ['#9a6f4c', '#8a603f', '#a77a56'], groove: '#211a14' },
  { label: 'Drop', note: 'Minute 14', bg: '#141012', palette: ['#3d2c22', '#32231b', '#463227'], groove: '#141012' },
];
// Coffee plates: lighter roast = lighter beans, on one cool ground. The house blend carries the warm bone note.
const roastTone: Record<number, string[]> = {
  2: ['#c8cad0', '#b9bcc4'],
  3: ['#8f939d', '#9a9ea8', '#848892'],
  4: ['#5c606a', '#656973', '#545862'],
};
const BONE = '#d7d5c6';
---

<Base title={`${brand.full} · Editorial`} themeColor="#15161b" bodyClass="ed" sample={3}>
  <script is:inline slot="head">
    (function () {
      try {
        var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        var seen = sessionStorage.getItem('gratia-pl-editorial');
        if (!reduced && (!seen || /[?&]intro/.test(location.search))) document.documentElement.classList.add('pl-on');
      } catch (e) {
        document.documentElement.classList.add('pl-on');
      }
    })();
  </script>

  <a class="skip-link" href="#main">Skip to content</a>

  <!-- WebGL atmosphere (three.js): a halftone field with RGB-split ripples. Never carries meaning. -->
  <canvas class="gl" aria-hidden="true"></canvas>

  <!-- The signature: a fixed exclusion-blend column grid that everything aligns to -->
  <div class="lines-wrapper" aria-hidden="true">
    <div class="lines-grid"><span></span><span></span><span></span><span></span></div>
  </div>

  <!-- Curtain intro: the 4 grid columns peel away -->
  <div class="intro" aria-hidden="true">
    <div class="intro__curtains">
      <span class="intro__curtain"></span><span class="intro__curtain"></span>
      <span class="intro__curtain"></span><span class="intro__curtain"></span>
    </div>
    <div class="intro__logo"><span class="intro__logo-border"></span></div>
  </div>

  <header class="header hideOnLoad">
    <a class="header__brand" href="#top" aria-label={`${brand.name}, back to top`}>
      <svg class="header__mark" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path d="M3 8V3h5M21 8V3h-5M3 16v5h5M21 16v5h-5" fill="none" stroke="currentColor" stroke-width="2.4"></path>
      </svg>
      <span class="header__word">{brand.name}</span>
    </a>
    <a class="btn header__cta" href="#order"><span>Subscribe</span></a>
  </header>

  <!-- Bottom-anchored chrome: each link sits in its own grid column -->
  <nav class="dock hideOnLoad" aria-label="Primary">
    {nav.map((n) => <a href={n.href}>{n.label}</a>)}
  </nav>

  <main id="main">
    <!-- 1. HERO -->
    <section class="hero hideOnLoad" id="top">
      <h1 class="hero__h1" aria-label={hero.headline}>
        <span class="hero__lead" aria-hidden="true">Coffee, with</span>
        <span class="hero__title" aria-hidden="true">thanks.</span>
      </h1>
      <p class="hero__support">{hero.lede}</p>
      <p class="hero__cta">
        <a class="btn" href="#order"><span>{hero.primaryCta}</span></a>
        <a class="btn" href="#coffee"><span>{hero.secondaryCta}</span></a>
      </p>
    </section>

    <!-- 2. PLATE BAND: roast stages as a contact sheet -->
    <section class="band" aria-label="Roast stages, from green to dropped">
      {stages.map((s, i) => (
        <figure class="plate">
          <BeanField id={`ed-st${i}`} seed={31 + i * 7} palette={s.palette} groove={s.groove} bg={s.bg} cols={4} rows={4} w={400} h={400} scale={[0.85, 1.1]} jitter={0.3} />
          <figcaption class="plate__label">{s.label}<span>{s.note}</span></figcaption>
        </figure>
      ))}
    </section>

    <!-- 3. MARQUEE -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">
        {[0, 1].map(() => <span>{thanks.join(' / ')} / </span>)}
      </div>
    </div>

    <!-- 4. STATEMENT -->
    <section class="statement" id="studio">
      <h2 class="visually-hidden">What we believe</h2>
      <p class="statement__text">{statement.text}</p>
    </section>

    <!-- 5. NUMBERS: ruled into the grid -->
    <section class="figures" aria-label="Gratia in numbers">
      <ul class="figures__grid">
        {stats.map((s) => (
          <li class="figures__item">
            <span class="figures__num">{s.value}<span class="figures__suffix">{s.suffix}</span></span>
            <span class="figures__label">{s.label}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- 6. COFFEES: Flip morphs between list and grid -->
    <section class="work" id="coffee" aria-labelledby="coffee-h">
      <div class="work__head">
        <h2 class="section-title" id="coffee-h">The coffees</h2>
        <div class="toggle" role="group" aria-label="Layout">
          <button type="button" class="toggle__b" data-layout="list" aria-pressed="true"><span>List</span></button>
          <button type="button" class="toggle__b" data-layout="grid" aria-pressed="false"><span>Grid</span></button>
        </div>
      </div>

      <div class="work__list">
        {coffees.map((c, i) => (
          <article class={`project ${i % 2 ? 'project--flip' : ''}`} data-flip-id={c.id}>
            <figure class="project__media plate">
              <BeanField id={`ed-${c.id}`} seed={c.name.length * 5 + i} palette={c.id === 'gracias' ? [BONE, '#b9b7a8'] : roastTone[c.roast === 2 ? 2 : c.roast === 3 ? 3 : 4]} groove="#1d1f26" bg="#1d1f26" cols={5} rows={5} w={500} h={500} scale={[0.85, 1.1]} jitter={0.3} />
              <figcaption class="plate__label">{c.roastLabel} roast</figcaption>
            </figure>
            <div class="project__text">
              <p class="project__premise">{c.blurb}</p>
              <h3 class="project__title">{c.name}</h3>
              <p class="project__desc">{c.origin} · {c.process} · {c.altitude}<br />{c.notes.join(', ')}.</p>
              <p class="project__buy">
                <span class="project__price">{c.price}<small> / {c.size}</small></span>
                <a class="btn" href="#order" aria-label={`Subscribe to ${c.name}`}><span>Subscribe</span></a>
              </p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 7. ROASTERY -->
    <section class="roastery" id="roastery" aria-labelledby="roast-h">
      <h2 class="section-title" id="roast-h">The roastery</h2>
      <ol class="roastery__grid">
        {process.map((p, i) => (
          <li class="roastery__item">
            <span class="roastery__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- 8. CAFÉS -->
    <section class="cafes" id="cafes" aria-labelledby="cafes-h">
      <h2 class="section-title" id="cafes-h">The cafés</h2>
      <ul class="cafes__list">
        {cafes.map((c) => (
          <li class="cafe">
            <h3 class="cafe__name">{c.name}</h3>
            <p class="cafe__where">{c.address}<span>{c.note}</span></p>
            <p class="cafe__hours">{c.hours}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- 9. ORDER -->
    <section class="contact" id="order" aria-labelledby="order-h">
      <h2 class="contact__h" id="order-h" aria-label={order.title}>
        <span class="hero__lead" aria-hidden="true">Beans at your door in</span>
        <span class="contact__title" aria-hidden="true">48 hours.</span>
      </h2>
      <p class="contact__text">{order.text}</p>

      <form class="form" data-mock-form>
        <label class="field">
          <span class="field__label">{order.emailLabel}</span>
          <input type="email" name="email" required autocomplete="email" placeholder={order.emailPlaceholder} />
        </label>
        <label class="field">
          <span class="field__label">{order.brewLabel}</span>
          <select name="brew">{order.brewOptions.map((o) => <option>{o}</option>)}</select>
        </label>
        <button class="btn btn--solid" type="submit"><span>{order.submit}</span></button>
        <p class="form__status" data-form-status role="status" aria-live="polite"></p>
      </form>

      <p class="contact__wholesale">{wholesale.text}
        <a class="contact__email" href={`mailto:${brand.email}`}><span>{brand.email}</span></a>
      </p>
    </section>
  </main>

  <footer class="footer">
    <div class="footer__cols">
      <div class="footer__col"><span class="footer__k">Roastery</span><p>Unit 4, Mill Lane<br />Wed–Sun · 9:00–16:00</p></div>
      <div class="footer__col"><span class="footer__k">Contact</span><p><a href={`mailto:${brand.email}`}>{brand.email}</a></p></div>
      <div class="footer__col"><span class="footer__k">The name</span><p>{brand.name}: {brand.meaning.toLowerCase()}.</p></div>
      <div class="footer__col"><span class="footer__k">Note</span><p>{brand.placeholderNote}</p></div>
    </div>
    <p class="footer__word" aria-hidden="true">{brand.name}</p>
    <p class="footer__legal">© {brand.year} {brand.name}</p>
  </footer>

  <script>
    import '../../scripts/editorial';
  </script>
</Base>

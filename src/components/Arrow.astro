---
/** Drawn arrow icon (one stroke weight everywhere), instead of a Unicode glyph. */
interface Props {
  dir?: 'right' | 'left' | 'up' | 'down';
  class?: string;
}
const { dir = 'right', class: cls = 'arrow' } = Astro.props;
const rot = { right: 0, left: 180, down: 90, up: -90 }[dir];
---

<svg class={cls} viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" focusable="false" style={`transform:rotate(${rot}deg)`}>
  <path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>

---
/** Radiating-spoke burst: the Motion sample's separator / logo flourish. Authored SVG, decorative. */
interface Props {
  spokes?: number;
  inner?: number;
  outer?: number;
  stroke?: number;
  class?: string;
}
const { spokes = 16, inner = 7, outer = 46, stroke = 2, class: cls = '' } = Astro.props;
const lines = Array.from({ length: spokes }, (_, i) => {
  const a = (i / spokes) * Math.PI * 2;
  // alternate long / short spokes for rhythm
  const o = i % 2 ? outer * 0.72 : outer;
  return {
    x1: (50 + Math.cos(a) * inner).toFixed(2),
    y1: (50 + Math.sin(a) * inner).toFixed(2),
    x2: (50 + Math.cos(a) * o).toFixed(2),
    y2: (50 + Math.sin(a) * o).toFixed(2),
  };
});
---

<svg class={cls} viewBox="0 0 100 100" aria-hidden="true" focusable="false">
  <g stroke="currentColor" stroke-width={stroke} stroke-linecap="round" fill="none">
    {lines.map((l) => <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2}></line>)}
  </g>
</svg>
